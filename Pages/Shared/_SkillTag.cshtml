@model string
@{
    var asset = TechIcons.AssetFor(Model);
    var symbol = TechIcons.SymbolFor(Model);
}
<span class="skill-name">
  @if (asset is not null)
  {
    <img class="skill-icon" src="@asset" alt="" width="16" height="16" decoding="async">
  }
  else if (symbol is not null)
  {
    <svg class="skill-icon" aria-hidden="true" focusable="false"><use href="#@symbol"></use></svg>
  }
  @Model
</span>
