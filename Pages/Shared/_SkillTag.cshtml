@model string
@{
    var asset = TechIcons.AssetFor(Model);
    var symbol = TechIcons.SymbolFor(Model);
}
<span class="tag">
  @if (asset is not null)
  {
    <img class="tag-icon" src="@asset" alt="" width="14" height="14" decoding="async">
  }
  else if (symbol is not null)
  {
    <svg class="tag-icon" aria-hidden="true" focusable="false"><use href="#@symbol"></use></svg>
  }
  @Model
</span>
