@model TimelineEntry
<article class="edu">
  <p class="edu-period">@Model.Period</p>
  <h3 class="edu-school">@Model.Title</h3>
  <p class="edu-program">@Model.Subtitle</p>
  @if (!string.IsNullOrWhiteSpace(Model.Text))
  {
    <p class="edu-text">@Model.Text</p>
  }
  @if (Model.Bullets.Count > 0)
  {
    <ul class="edu-list">
      @foreach (var bullet in Model.Bullets)
      {
        <li>@bullet</li>
      }
    </ul>
  }
</article>
