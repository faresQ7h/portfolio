@model ProjectCardModel
@{
    var project = Model.Project;
    var image = Model.Image;
    var detailsUrl = $"/projects/{project.Slug}";
    // Images the server couldn't measure get "needs-fit-check" so site.js can decide their fit at runtime.
    var shotClass = "project-shot"
        + (image.NeedsContainFit ? " fit-contain" : "")
        + (image.Size is null ? " needs-fit-check" : "");
}
<article class="project-card">
  <a class="project-media" href="@detailsUrl" aria-label="View @project.Name details">
    <img class="@shotClass" src="@image.Url" alt="@project.Name project preview"
         width="@(image.Size?.Width ?? 720)" height="@(image.Size?.Height ?? 420)" loading="lazy" decoding="async">
  </a>
  <div class="project-card-body">
    <div class="project-meta">
      <span class="status">@project.Status</span>
      <span>@string.Join(" / ", project.Technologies.Take(3))</span>
    </div>
    <h3>@project.Name</h3>
    <p>@project.Description</p>
    <div class="tag-row">
      @foreach (var skill in project.SkillsDemonstrated.Take(4))
      {
        <span class="tag">@skill</span>
      }
    </div>
    <div class="card-actions">
      <a class="button button-secondary" href="@detailsUrl">Details</a>
      @if (!string.IsNullOrEmpty(project.GitHubUrl))
      {
        @await Html.PartialAsync("_GitHubButton", new GitHubButtonModel(project.GitHubUrl, "button button-ghost", "GitHub", $"View {project.Name} on GitHub"))
      }
    </div>
  </div>
</article>
