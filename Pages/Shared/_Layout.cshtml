@{
    var meta = (PageMeta)ViewData["Meta"]!;
    var isHome = ViewData["IsHome"] is true;
    // On the home page the nav scrolls within the page; elsewhere it links back to the home sections.
    var sectionPrefix = isHome ? "" : "/";
    var ogTitle = meta.OgTitle ?? meta.Title;
    var ogDescription = meta.OgDescription ?? meta.Description;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@meta.Title</title>
  @if (meta.CanonicalPath is null)
  {
  <meta name="robots" content="noindex">
  }
  else
  {
  <meta name="robots" content="index,follow">
  }
  <meta name="description" content="@meta.Description">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="@ogTitle">
  <meta property="og:description" content="@ogDescription">
  <meta property="og:type" content="@meta.OgType">
  @if (meta.CanonicalUrl is not null)
  {
  <meta property="og:url" content="@meta.CanonicalUrl">
  }
  @if (meta.OgImage is not null)
  {
  <meta property="og:image" content="@meta.OgImage">
  }
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="@ogTitle">
  <meta name="twitter:description" content="@ogDescription">
  @if (meta.OgImage is not null)
  {
  <meta name="twitter:image" content="@meta.OgImage">
  }
  <meta name="theme-color" content="#0c0f14">
  @if (meta.CanonicalUrl is not null)
  {
  <link rel="canonical" href="@meta.CanonicalUrl">
  }
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  @* Apply a saved theme choice before first paint; without one, the dark theme applies.
     The "js" class lets CSS collapse the mobile menu only when the script that opens it can run. *@
  <script>
    document.documentElement.classList.add("js");
    try {
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") {
        document.documentElement.dataset.theme = theme;
        const color = theme === "dark" ? "#0c0f14" : "#f7f7f5";
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute("content", color));
      }
    } catch (error) { /* storage unavailable: fall back to the system setting */ }
  </script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GVMJYPKS94"></script>
  <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GVMJYPKS94');
  </script>
  <script src="~/js/site.js" asp-append-version="true" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
  @await RenderSectionAsync("Head", required: false)
</head>
<body>
  @await RenderSectionAsync("BodyStart", required: false)
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <nav class="nav container" aria-label="Main navigation">
      <a class="brand" href="@(isHome ? "#home" : "/")" aria-label="Fares Mohamed home">
        <span class="brand-mark" aria-hidden="true">FM</span>
        <span class="brand-name">Fares Mohamed</span>
      </a>
      <div class="nav-links" id="site-menu" data-nav-menu>
        <a href="@(sectionPrefix)#about">About</a>
        <a href="@(sectionPrefix)#skills">Skills</a>
        <a href="@(sectionPrefix)#projects">Projects</a>
        <a href="@(sectionPrefix)#education">Education</a>
        <a href="@(sectionPrefix)#contact">Contact</a>
      </div>
      <div class="nav-tools">
        @* Both buttons stay hidden until site.js wires them up, so they never show as dead buttons without JavaScript. *@
        <button class="icon-toggle theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" hidden>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"/></svg>
        </button>
        <button class="icon-toggle nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-nav-toggle hidden>
          <span class="sr-only">Toggle navigation</span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>
      </div>
    </nav>
  </header>

  @RenderBody()

  <footer class="site-footer">
    <div class="container footer-grid">
      <p>&copy; @DateTime.UtcNow.Year Fares Mohamed</p>
      @if (isHome)
      {
      <a href="#home">Back to top</a>
      }
      else
      {
      <a href="/">Home</a>
      }
    </div>
  </footer>
</body>
</html>
