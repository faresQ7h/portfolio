@page "/projects/{slug}"
@model FaresPortfolio.Pages.Projects.DetailModel
@{
    var project = Model.Project;
    var media = Model.Media;
    var screenshots = Model.Screenshots;
    var hasGallery = screenshots.Count > 1;
}
@section Scripts {
  <script src="~/js/project.js" asp-append-version="true" defer></script>
}

  <main id="main" class="project-page">
    <section class="detail-hero">
      <div class="container detail-grid">
        <div class="detail-copy">
          <a class="back-link" href="/#projects"><span aria-hidden="true">&larr;</span> All projects</a>
          <p class="meta"><span class="pill">@project.Status.ToLowerInvariant()</span><span>@string.Join(" / ", project.Technologies.Take(3))</span></p>
          <h1 class="detail-title">@project.Name</h1>
          <p class="detail-desc">@project.Description</p>
          <ul class="tags" aria-label="Technologies">
            @foreach (var technology in project.Technologies)
            {
              <li>@technology</li>
            }
          </ul>
          <div class="hero-actions">
            @if (!string.IsNullOrEmpty(project.GitHubUrl))
            {
              @await Html.PartialAsync("_GitHubButton", new GitHubButtonModel(project.GitHubUrl, "button button-primary", "View GitHub"))
            }
            <a class="button" href="/#projects">All projects</a>
          </div>
        </div>

        <div class="detail-media">
          @if (media.Kind == ProjectMediaKind.Diagram)
          {
            <figure class="media-frame media-diagram">
              <partial name="_ProjectDiagram" model="new DiagramModel(media.Diagram!, Decorative: false)" />
            </figure>
          }
          else if (media.Kind == ProjectMediaKind.Terminal)
          {
            <partial name="_Terminal" model="new TerminalModel(media.Terminal!, Compact: false, ShowCaption: true)" />
          }

          @if (screenshots.Count > 0)
          {
            var mainImage = screenshots[0];
            <div class="gallery">
              <div class="gallery-stage media-frame" data-gallery data-gallery-label="@project.Name screenshot gallery, use the arrow buttons or left/right arrow keys to browse">
                <img class="gallery-image" data-gallery-image src="@mainImage.Url" alt="@project.Name screenshot"
                     width="@(mainImage.Size?.Width ?? 720)" height="@(mainImage.Size?.Height ?? 420)"
                     loading="@(media.Kind == ProjectMediaKind.Image ? "eager" : "lazy")" decoding="async">
                @if (hasGallery)
                {
                  <button class="gallery-arrow gallery-arrow-prev" type="button" data-gallery-prev aria-label="Previous screenshot" hidden>&#10094;</button>
                  <button class="gallery-arrow gallery-arrow-next" type="button" data-gallery-next aria-label="Next screenshot" hidden>&#10095;</button>
                }
              </div>
              @if (hasGallery)
              {
                <div class="thumb-row" role="group" aria-label="@project.Name screenshots">
                  @for (var index = 0; index < screenshots.Count; index++)
                  {
                    var shot = screenshots[index];
                    var isFirst = index == 0;
                    @* Real links to the full image, so the thumbnails still work without JavaScript. *@
                    <a class="@(isFirst ? "thumb is-active" : "thumb")" href="@shot.Url" data-gallery-thumb
                       data-width="@shot.Size?.Width" data-height="@shot.Size?.Height"
                       aria-label="Show screenshot @(index + 1) of @screenshots.Count" aria-current="@(isFirst ? "true" : null)">
                      <img src="@shot.Url" alt="" width="160" height="100" loading="lazy" decoding="async">
                    </a>
                  }
                </div>
              }
            </div>
          }
        </div>
      </div>
    </section>

    <section class="section detail-body" data-reveal>
      <div class="container detail-sections">
        @foreach (var block in Model.Sections)
        {
          <article class="detail-block">
            <h2>@block.Title</h2>
            @if (block.Items.Count > 0)
            {
              <ul>
                @foreach (var item in block.Items)
                {
                  <li>@item</li>
                }
              </ul>
            }
            else
            {
              <p>@block.Text</p>
            }
          </article>
        }
      </div>
    </section>
  </main>
