@page "/status/{code:int}"
@model StatusModel

  <main id="main" class="project-page">
    <section class="detail-hero">
      <div class="container status-copy">
        <p class="kicker">// @Model.Code</p>
        @if (Model.IsNotFound)
        {
          <h1 class="detail-title">Page not found</h1>
          <p class="detail-desc">The page you're looking for doesn't exist or has moved.</p>
        }
        else
        {
          <h1 class="detail-title">Something went wrong</h1>
          <p class="detail-desc">The request couldn't be completed.</p>
        }
        <div class="hero-actions">
          <a class="button button-primary" href="/">Return home</a>
          <a class="button" href="/#projects">All projects</a>
        </div>
      </div>
    </section>
  </main>
