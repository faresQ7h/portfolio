@page
@model IndexModel
@{
    var personal = Model.Profile.Personal;
    // "https://www.linkedin.com/in/x/" -> "linkedin.com/in/x", for display next to the link.
    static string DisplayUrl(string url) =>
        url.Replace("https://", "").Replace("http://", "").Replace("www.", "").TrimEnd('/');
}
@section Head {
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "Person",
    "name": "Fares Mohamed",
    "url": "https://faresm.dev/",
    "sameAs": [
      "https://github.com/faresQ7h",
      "https://www.linkedin.com/in/fares-mohamed-it"
    ]
  }
  </script>
}
@section BodyStart {
  <partial name="_IconSprite" />
}

  <main id="main" data-trace>
    <section class="hero" id="home" aria-labelledby="hero-name" data-pointer-glow>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-status"><span class="status-dot" aria-hidden="true"></span>open to software engineering internships</p>
          <h1 class="hero-name" id="hero-name">@personal.Name</h1>
          <p class="hero-pitch">@TextHtml.KeepSlashedWordsTogether(personal.Headline)</p>
          <p class="hero-summary">@personal.Summary</p>
          <div class="hero-actions">
            <a class="button button-primary" href="@Model.RequestCvHref">Request CV</a>
            @await Html.PartialAsync("_GitHubButton", new GitHubButtonModel(personal.GitHubUrl, "button", "GitHub"))
            <a class="button" href="@Model.EmailHref"><svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-mail"></use></svg>Email</a>
          </div>
        </div>
        <div class="hero-spec">
          <img class="hero-portrait" src="@personal.AvatarUrl" alt="Portrait of @personal.Name" width="240" height="240" fetchpriority="high" decoding="async">
          <dl class="spec-list">
            <div>
              <dt>location</dt>
              <dd>@personal.Location</dd>
            </div>
            <div>
              <dt>focus</dt>
              <dd>Backend, systems programming, cloud &amp; databases</dd>
            </div>
            <div>
              <dt>education</dt>
              <dd>CZU Informatics + 42 Prague</dd>
            </div>
            @if (Model.Profile.SpokenLanguages.Count > 0)
            {
              <div>
                <dt>languages</dt>
                <dd>@string.Join(", ", Model.Profile.SpokenLanguages.Select(language => $"{language.Name} ({language.Level})"))</dd>
              </div>
            }
          </dl>
        </div>
      </div>
      <div class="container">
        <dl class="stats">
          @foreach (var stat in Model.Profile.Stats)
          {
            <div class="stat">
              <dt class="stat-label">@stat.Label</dt>
              <dd class="stat-value">@stat.Value</dd>
            </div>
          }
        </dl>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title" data-reveal>
      <div class="container about-grid">
        <div class="section-head">
          <p class="kicker">// about</p>
          <h2 class="section-title" id="about-title">About me</h2>
        </div>
        <div class="prose">
          @foreach (var paragraph in Model.Profile.About)
          {
            <p>@paragraph</p>
          }
          @if (Model.Profile.SpokenLanguages.Count > 0)
          {
            <p class="languages-line">
              <span class="languages-label">Languages</span>
              @string.Join(" · ", Model.Profile.SpokenLanguages.Select(language => $"{language.Name} ({language.Level})"))
            </p>
          }
        </div>
        <ul class="focus-list" aria-label="Areas of focus">
          <li>
            <span class="focus-label">Backend</span>
            <p>REST APIs, client-server architecture, and maintainable C#/.NET code.</p>
          </li>
          <li>
            <span class="focus-label">Systems</span>
            <p>C, Linux, POSIX, process management, memory debugging, and shell projects.</p>
          </li>
          <li>
            <span class="focus-label">Databases</span>
            <p>PostgreSQL, ER modeling, normalization, constraints, and SQL reporting.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <p class="kicker">// skills</p>
          <h2 class="section-title" id="skills-title">Technical skills</h2>
        </div>
        <div class="skills-grid">
          @foreach (var group in Model.Skills)
          {
            <article class="skill-group">
              <div class="skill-group-head">
                <span class="skill-badge" aria-hidden="true">@group.Icon</span>
                <h3>@group.Name</h3>
              </div>
              <ul class="skill-list">
                @foreach (var skill in group.Items)
                {
                  <li>
                    <partial name="_SkillTag" model="skill.Name" />
                    @if (skill.UsedIn.Count > 0)
                    {
                      <span class="skill-used">used in
                        @for (var i = 0; i < skill.UsedIn.Count; i++)
                        {
                          var used = skill.UsedIn[i];
                          <a href="/projects/@used.Slug">@used.Name</a>@(i < skill.UsedIn.Count - 1 ? ", " : "")
                        }
                      </span>
                    }
                  </li>
                }
              </ul>
            </article>
          }
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title" data-reveal>
      <div class="container">
        <div class="section-head section-head-row">
          <div>
            <p class="kicker">// projects</p>
            <h2 class="section-title" id="projects-title">Selected engineering work</h2>
          </div>
          <a class="text-link" href="@personal.GitHubUrl" target="_blank" rel="noopener">All repositories on GitHub</a>
        </div>
        <div class="feature-list">
          @foreach (var card in Model.FeaturedProjects)
          {
            <partial name="_ProjectFeature" model="card" />
          }
        </div>
        @if (Model.OtherProjects.Count > 0)
        {
          <div class="more-projects">
            <h3 class="more-title">More projects</h3>
            <div class="card-grid">
              @foreach (var card in Model.OtherProjects)
              {
                <partial name="_ProjectCard" model="card" />
              }
            </div>
          </div>
        }
      </div>
    </section>

    <section class="section" id="education" aria-labelledby="education-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <p class="kicker">// education</p>
          <h2 class="section-title" id="education-title">Academic path</h2>
        </div>
        <div class="edu-grid">
          @foreach (var entry in Model.Education)
          {
            <partial name="_TimelineItem" model="entry" />
          }
        </div>
      </div>
    </section>

    <section class="section" id="learning" aria-labelledby="learning-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <p class="kicker">// learning</p>
          <h2 class="section-title" id="learning-title">Next areas of depth</h2>
        </div>
        <ul class="learning-list">
          @foreach (var item in Model.Profile.CurrentlyLearning)
          {
            var symbol = TechIcons.LearningSymbolFor(item.Name);
            <li>
              <h3 class="learning-title">
                @if (symbol is not null)
                {
                  <svg class="skill-icon" aria-hidden="true" focusable="false"><use href="#@symbol"></use></svg>
                }
                @item.Name
              </h3>
              <p>@item.Focus</p>
            </li>
          }
        </ul>
      </div>
    </section>

    <section class="section section-contact" id="contact" aria-labelledby="contact-title" data-reveal>
      <div class="container contact-grid">
        <div class="section-head">
          <p class="kicker">// contact</p>
          <h2 class="section-title" id="contact-title">Get in touch</h2>
        </div>
        <ul class="contact-list">
          <li>
            <span class="contact-key"><svg class="contact-icon" aria-hidden="true" focusable="false"><use href="#icon-mail"></use></svg>email</span>
            <a href="@Model.EmailHref">@personal.Email</a>
          </li>
          <li>
            <span class="contact-key"><svg class="contact-icon" aria-hidden="true" focusable="false"><use href="#icon-github"></use></svg>github</span>
            <a href="@personal.GitHubUrl" target="_blank" rel="noopener">@DisplayUrl(personal.GitHubUrl)</a>
          </li>
          <li>
            <span class="contact-key"><svg class="contact-icon" aria-hidden="true" focusable="false"><use href="#icon-linkedin"></use></svg>linkedin</span>
            <a href="@personal.LinkedInUrl" target="_blank" rel="noopener">@DisplayUrl(personal.LinkedInUrl)</a>
          </li>
        </ul>
      </div>
    </section>
  </main>
