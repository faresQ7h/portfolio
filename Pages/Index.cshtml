@page
@model IndexModel
@{
    var personal = Model.Profile.Personal;
}
@section Head {
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@type": "Person",
    "name": "Fares Mohamed",
    "url": "https://faresm.dev/",
    "sameAs": [
      "https://github.com/faresQ7h",
      "https://www.linkedin.com/in/fares-mohamed-it"
    ]
  }
  </script>
}
@section BodyStart {
  <partial name="_IconSprite" />
}

  <main id="main">
    <section class="hero section" id="home">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Open to software engineering internships</p>
          <h1>@personal.Name</h1>
          <p class="headline">@personal.Headline</p>
          <p class="hero-summary">@personal.Summary</p>
          <div class="hero-actions">
            <a class="icon-button" href="@personal.GitHubUrl" target="_blank" rel="noopener" aria-label="GitHub profile">
              <img src="/assets/icons/githupLogo.svg" alt="" width="20" height="20" decoding="async">
            </a>
            <a class="icon-button" href="@personal.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn profile">
              <img src="/assets/icons/linkedinLogo.svg" alt="" width="20" height="20" decoding="async">
            </a>
          </div>
          <p class="resume-note">Resume available upon request &mdash; <a class="text-link" href="#contact">Contact me</a></p>
        </div>
        <aside class="identity-panel" aria-label="Profile snapshot">
          <img class="avatar" src="@personal.AvatarUrl" alt="Portrait of @personal.Name" width="240" height="240" fetchpriority="high" decoding="async">
          <dl class="identity-list">
            <div>
              <dt>Location</dt>
              <dd>@personal.Location</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>Backend Engineering, Systems Programming, Cloud &amp; Databases</dd>
            </div>
            <div>
              <dt>Education</dt>
              <dd>CZU Informatics + 42 Prague</dd>
            </div>
          </dl>
        </aside>
      </div>
      <div class="container stats-grid">
        @foreach (var stat in Model.Profile.Stats)
        {
          <article class="stat-card">
            <strong>@stat.Value</strong>
            <span>@stat.Label</span>
          </article>
        }
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="container about-stack">
        <div class="section-heading">
          <p class="eyebrow">About</p>
          <h2 id="about-title">About Me</h2>
        </div>
        <div class="prose">
          @foreach (var paragraph in Model.Profile.About)
          {
            <p>@paragraph</p>
          }
        </div>
        <div class="about-highlights" aria-label="Profile highlights">
          <article>
            <span>Backend</span>
            <p>REST APIs, client-server architecture, and maintainable C#/.NET code.</p>
          </article>
          <article>
            <span>Systems</span>
            <p>C, Linux, POSIX, process management, memory debugging, and shell projects.</p>
          </article>
          <article>
            <span>Databases</span>
            <p>PostgreSQL, ER modeling, normalization, constraints, and SQL reporting.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="skills" aria-labelledby="skills-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Skills</p>
          <h2 id="skills-title">Technical Skills</h2>
        </div>
        <div class="skills-grid">
          @foreach (var category in Model.Profile.Skills)
          {
            <article class="skill-card">
              <div class="skill-card-header">
                <span class="skill-icon">@category.Icon</span>
                <h3>@category.Name</h3>
              </div>
              <div class="tag-row">
                @foreach (var item in category.Items)
                {
                  <partial name="_SkillTag" model="item" />
                }
              </div>
            </article>
          }
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-heading heading-row">
          <div>
            <p class="eyebrow">Projects</p>
            <h2 id="projects-title">Selected engineering work</h2>
          </div>
          <a class="text-link" href="@personal.GitHubUrl" target="_blank" rel="noopener">View GitHub</a>
        </div>
        <div class="project-grid">
          @foreach (var card in Model.Projects)
          {
            <partial name="_ProjectCard" model="card" />
          }
        </div>
      </div>
    </section>

    <section class="section section-muted" id="education" aria-labelledby="education-title">
      <div class="container two-column">
        <div>
          <div class="section-heading compact">
            <p class="eyebrow">Education</p>
            <h2 id="education-title">Academic path</h2>
          </div>
          <div class="timeline">
            @foreach (var entry in Model.Education)
            {
              <partial name="_TimelineItem" model="entry" />
            }
          </div>
        </div>
        <div>
          <div class="section-heading compact">
            <p class="eyebrow">Experience</p>
            <h2>Applied practice</h2>
          </div>
          <div class="timeline">
            @foreach (var entry in Model.Experience)
            {
              <partial name="_TimelineItem" model="entry" />
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="learning" aria-labelledby="learning-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Currently Learning</p>
          <h2 id="learning-title">Next areas of depth</h2>
        </div>
        <div class="learning-grid">
          @foreach (var item in Model.Profile.CurrentlyLearning)
          {
            var symbol = TechIcons.LearningSymbolFor(item.Name);
            <article class="learning-card">
              @if (symbol is not null)
              {
                <h3 class="learning-card-title">
                  <svg class="learning-icon" aria-hidden="true" focusable="false"><use href="#@symbol"></use></svg>
                  @item.Name
                </h3>
              }
              else
              {
                <h3>@item.Name</h3>
              }
              <p>@item.Focus</p>
            </article>
          }
        </div>
      </div>
    </section>

    <section class="section section-contact" id="contact" aria-labelledby="contact-title">
      <div class="container contact-layout">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">Connect with me</h2>
          <div class="connect-list" aria-label="Contact methods">
            <a class="connect-item" href="@($"mailto:{personal.Email}")">
              <img class="connect-icon" src="/assets/icons/gmailLogo.svg" alt="" width="20" height="20" decoding="async">
              <span class="connect-label">@personal.Email</span>
            </a>
            <a class="connect-item" href="@personal.GitHubUrl" target="_blank" rel="noopener">
              <img class="connect-icon" src="/assets/icons/githupLogo.svg" alt="" width="20" height="20" decoding="async">
              <span class="connect-label">GitHub</span>
            </a>
            <a class="connect-item" href="@personal.LinkedInUrl" target="_blank" rel="noopener">
              <img class="connect-icon" src="/assets/icons/linkedinLogo.svg" alt="" width="20" height="20" decoding="async">
              <span class="connect-label">LinkedIn</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
